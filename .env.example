# Third-Party Transactional Email Adapter (Resend REST API)
# Set real credentials in the AI Studio Secrets panel to enable live transactional email dispatch.
# Note: Firebase AI Logic (Gemini) uses Firebase App Check automatically and requires NO API key here.
RESEND_API_KEY=MY_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev
